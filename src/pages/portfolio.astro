---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Portfolio"
  description="Bolas Lien 的作品集"
>
  <section class="portfolio">
    <h1>Portfolio</h1>
    <p class="coming-soon">作品集整理中，敬請期待。</p>
  </section>
</BaseLayout>

<style>
  .portfolio {
    padding: 28px 0;
  }
  .portfolio h1 {
    font-size: 32px;
    font-weight: 800;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .coming-soon {
    font-size: 16px;
    color: var(--fg-2);
  }
</style>
