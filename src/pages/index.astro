---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Bolas Lien"
  description="前端工程師，專注在架構、工作流與寫作"
>
  <section class="hero">
    <h1 class="hero-name">Bolas Lien</h1>
    <p class="hero-tagline">前端工程師，專注在架構、工作流與寫作</p>
    <div class="hero-links">
      <a href="/blog/" class="hero-btn hero-btn-primary">部落格</a>
      <a href="/portfolio/" class="hero-btn">作品集</a>
      <a href="/about/" class="hero-btn">關於</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 60vh;
    padding: 48px 0;
  }
  .hero-name {
    font-size: 56px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 16px;
  }
  .hero-tagline {
    font-size: 20px;
    color: var(--fg-2);
    margin: 0 0 32px;
    max-width: 480px;
    line-height: 1.5;
  }
  .hero-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--border);
    color: var(--fg-1);
    transition: border-color 120ms ease, color 120ms ease, background 120ms ease;
  }
  .hero-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .hero-btn-primary {
    background: var(--fg-1);
    color: var(--bg-1);
    border-color: var(--fg-1);
  }
  .hero-btn-primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }
  @media (max-width: 480px) {
    .hero-name { font-size: 40px; }
    .hero-tagline { font-size: 17px; }
  }
</style>
